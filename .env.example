# confezy example configuration.
# Copy and edit:  cp .env.example .env
#
# Notes:
#   - .env is gitignored; .env.example is committed.
#   - Real environment variables win over anything set in .env.
#   - Values are taken literally; keep comments on their own line.

# --- Admin account --------------------------------------------------------
# If the account does NOT exist, it is created at startup with these values.
# If it DOES exist, its password is left alone. To change it:
#   confezy admin-create -username admin -reset
CONFEZY_ADMIN_USERNAME=admin
CONFEZY_ADMIN_PASSWORD=change-this-password

# Read the password from a file instead of the environment (docker/k8s
# secrets). When set, this takes precedence over CONFEZY_ADMIN_PASSWORD.
# CONFEZY_ADMIN_PASSWORD_FILE=/run/secrets/confezy_admin_password

# --- Demo data ------------------------------------------------------------
# Inserts a demo dataset (projects, environments, flags, configs, API keys)
# the first time the service starts against an empty database, so the admin
# panel has something to show. Restarts never duplicate it and real data is
# never overwritten. Set to 0 for a clean install.
CONFEZY_SEED_DATA=1

# --- Docker Compose -------------------------------------------------------
# Host port to publish. Inside the container the service always listens on 8080.
CONFEZY_PORT=8080
